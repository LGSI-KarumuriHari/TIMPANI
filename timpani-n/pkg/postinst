# Post-install script for timpani-n (.deb / .rpm)
set -e

echo "Refreshing shared library cache (for bundled libtrpc.so)..."
ldconfig

echo "Enabling and starting timpani-n service..."
systemctl daemon-reload
systemctl enable timpani-n.service
systemctl restart timpani-n.service

exit 0
