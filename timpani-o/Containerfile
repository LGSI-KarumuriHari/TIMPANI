#
# timpani-o is released as a Podman container image.
# Build context: repo root (needed for the sibling ../libtrpc dependency)
#
# Usage:
#   VERSION=0.1.0
#   podman build --build-arg VERSION=$VERSION \
#     -f timpani-o/Containerfile -t timpani-o:$VERSION .

# ---------------------------------------------------------------------------
# Stage 1 — builder (Ubuntu 22.04)
# ---------------------------------------------------------------------------
FROM ubuntu:22.04 AS builder

ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    libgrpc++-dev \
    libprotobuf-dev \
    protobuf-compiler-grpc \
    pkg-config \
    libsystemd-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

# Copy shared dependency first (better layer caching)
COPY libtrpc/ libtrpc/

# Copy timpani-o source
COPY timpani-o/ timpani-o/

ARG VERSION=0.1.0
LABEL version="${VERSION}" \
      project="timpani" \
      component="timpani-o"

# Build
WORKDIR /src/timpani-o
RUN mkdir -p build && cd build && cmake .. && make -j"$(nproc)"

# Collect just the shared libraries timpani-o actually links against (per
# `ldd build/timpani-o`) into /rootfs, so the runtime stage doesn't need the
# full Ubuntu userland. This is what lets stage 2 be Alpine-based instead of
# another full Ubuntu image.
RUN mkdir -p /rootfs/lib64 /rootfs/lib/x86_64-linux-gnu && \
    cp /lib64/ld-linux-x86-64.so.2 /rootfs/lib64/ && \
    for lib in \
        libgrpc++.so.1 libgrpc.so.10 libgpr.so.10 \
        libprotobuf.so.23 \
        libsystemd.so.0 \
        libstdc++.so.6 libgcc_s.so.1 libc.so.6 libm.so.6 \
        libabsl_strings.so.20210324 libabsl_strings_internal.so.20210324 \
        libabsl_int128.so.20210324 libabsl_throw_delegate.so.20210324 \
        libabsl_raw_logging_internal.so.20210324 libabsl_time.so.20210324 \
        libabsl_bad_optional_access.so.20210324 libabsl_str_format_internal.so.20210324 \
        libabsl_time_zone.so.20210324 libabsl_base.so.20210324 \
        libabsl_spinlock_wait.so.20210324 \
        libssl.so.3 libcrypto.so.3 \
        libz.so.1 liblzma.so.5 libzstd.so.1 liblz4.so.1 \
        libcap.so.2 libgcrypt.so.20 libgpg-error.so.0 libcares.so.2 \
    ; do \
        cp /lib/x86_64-linux-gnu/"$lib" /rootfs/lib/x86_64-linux-gnu/ ; \
    done && \
    cp /src/timpani-o/build/libtrpc/libtrpc.so.2.0.0 /rootfs/lib/x86_64-linux-gnu/libtrpc.so.2

# ---------------------------------------------------------------------------
# Stage 2 — runtime (minimal Alpine 3.21 + hand-picked glibc libs)
# ---------------------------------------------------------------------------
# timpani-o is linked against glibc/gRPC/Protobuf, so we can't run it directly
# on Alpine's musl libc. Instead we start from Alpine's tiny base and copy in
# only the exact shared objects the binary needs (collected above), avoiding
# the ~80MB Ubuntu rootfs + `apt-get install` overhead of a full Ubuntu image.
FROM alpine:3.21

ARG VERSION=0.1.0
LABEL version="${VERSION}" \
      project="timpani" \
      component="timpani-o"

WORKDIR /timpani-o

COPY --from=builder /rootfs/lib64/ /lib64/
COPY --from=builder /rootfs/lib/x86_64-linux-gnu/ /lib/x86_64-linux-gnu/

COPY --from=builder /src/timpani-o/build/timpani-o /timpani-o/timpani-o
COPY --from=builder /src/timpani-o/examples/node_configurations.yaml /timpani-o/examples/

# Ports
# 50052: gRPC SchedInfoServer (Pullpiri -> timpani-o)
# 7777 : D-Bus/libtrpc server (timpani-n <-> timpani-o)
EXPOSE 50052 7777

ENV SINFO_PORT=50052
ENV DBUS_PORT=7777
ENV FAULT_HOST=localhost
ENV FAULT_PORT=50053

ENTRYPOINT ["/timpani-o/timpani-o"]
CMD ["-s", "50052", "-d", "7777"]

